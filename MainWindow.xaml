<Window x:Class="NeteaseGameDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NeteaseGameDownloader"
        Title="网易游戏下载器 · 蛋仔派对 / MuMu模拟器"
        Width="900" Height="740" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#1f1f23" Foreground="#e6e6ea"
        FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1f1f23"/>
        <SolidColorBrush x:Key="Panel" Color="#2a2a31"/>
        <SolidColorBrush x:Key="Panel2" Color="#32323b"/>
        <SolidColorBrush x:Key="Border" Color="#3c3c46"/>
        <SolidColorBrush x:Key="Fg" Color="#e6e6ea"/>
        <SolidColorBrush x:Key="Muted" Color="#9a9aa5"/>
        <SolidColorBrush x:Key="Accent" Color="#4cc2ff"/>
        <SolidColorBrush x:Key="Ok" Color="#6dd66d"/>
        <SolidColorBrush x:Key="Warn" Color="#ffd166"/>
        <SolidColorBrush x:Key="Err" Color="#ff6b6b"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3a3a44"/>
            <Setter Property="Foreground" Value="#e6e6ea"/>
            <Setter Property="BorderBrush" Value="#4a4a55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#474752"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#26262c"/>
                                <Setter Property="Foreground" Value="#5e5e68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2f7fb0"/>
            <Setter Property="BorderBrush" Value="#4cc2ff"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3a93c9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#26262c"/>
                    <Setter Property="BorderBrush" Value="#3c3c46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e6e6ea"/>
            <Setter Property="Margin" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e6e6ea"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#16161a"/>
            <Setter Property="Foreground" Value="#e6e6ea"/>
            <Setter Property="BorderBrush" Value="#3c3c46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#16161a"/>
            <Setter Property="Foreground" Value="#e6e6ea"/>
            <Setter Property="BorderBrush" Value="#3c3c46"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#9a9aa5"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#4cc2ff"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide">
                                <Border Background="#16161a" BorderBrush="#3c3c46" BorderThickness="1"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#e6e6ea"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3a3a44"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2f7fb0"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#16161a"/>
            <Setter Property="Foreground" Value="#4cc2ff"/>
            <Setter Property="BorderBrush" Value="#3c3c46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="18"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Foreground" Value="#4cc2ff"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="网易游戏下载器" FontSize="20" FontWeight="Bold" Foreground="#4cc2ff"/>
            <TextBlock Text="蛋仔派对 / MuMu模拟器 · 多线程断点续传" Foreground="#9a9aa5" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 设置区 -->
        <Border Grid.Row="1" Background="#2a2a31" BorderBrush="#3c3c46" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="产品" Width="72" Foreground="#9a9aa5"/>
                    <ComboBox x:Name="ProductCombo" Width="380" SelectionChanged="ProductCombo_SelectionChanged"/>
                    <TextBlock x:Name="ProductDesc" Foreground="#9a9aa5" Margin="12,0,0,0" MaxWidth="380" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <TextBlock Text="线程数" Width="72" Foreground="#9a9aa5"/>
                    <Slider x:Name="ThreadsSlider" Minimum="1" Maximum="16" Value="8"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ThreadsSlider_ValueChanged"/>
                    <TextBlock x:Name="ThreadsValue" Text="8" Width="28" Foreground="#4cc2ff" FontWeight="Bold"/>
                    <CheckBox x:Name="AutoThreadsCheck" Content="自适应（按文件大小自动调整上限，最高 16）"
                              Checked="AutoThreadsCheck_Changed" Unchecked="AutoThreadsCheck_Changed"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="保存路径" Width="72" Foreground="#9a9aa5"/>
                    <TextBox x:Name="PathBox" Width="420"/>
                    <Button x:Name="BrowseBtn" Content="浏览…" Click="BrowseBtn_Click"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="VerifyCheck" Content="下载完成后校验完整性（MD5/SHA256 / APK 签名）" IsChecked="True"/>
                    <CheckBox x:Name="KeepCheck" Content="保留校验文件（不自动清理 .checksum）"/>
                    <CheckBox x:Name="ForceCheck" Content="强制重新下载（忽略已有文件）"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 按钮区 -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="StartBtn" Content="开始下载" Style="{StaticResource PrimaryBtn}" Click="StartBtn_Click"/>
            <Button x:Name="InfoBtn" Content="查看信息" Click="InfoBtn_Click"/>
            <Button x:Name="PauseBtn" Content="暂停" Click="PauseBtn_Click"/>
            <Button x:Name="ResumeBtn" Content="继续" Click="ResumeBtn_Click"/>
            <Button x:Name="CancelBtn" Content="取消" Click="CancelBtn_Click"/>
            <Button x:Name="OpenBtn" Content="打开文件夹" Click="OpenBtn_Click"/>
        </WrapPanel>

        <!-- 进度 + 状态数据 -->
        <Border Grid.Row="3" Background="#2a2a31" BorderBrush="#3c3c46" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="TotalBar" Grid.Column="0" Value="0"/>
                    <TextBlock x:Name="PercentLabel" Grid.Column="1" Text="0.0%"
                               Margin="10,0,0,0" Foreground="#4cc2ff" FontWeight="Bold" Width="60"/>
                </Grid>
                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="已下 / 总计：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="DoneLabel" Text="0 B / 0 B" FontWeight="Bold" Margin="0,0,14,0"/>
                    <TextBlock Text="速度：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="SpeedLabel" Text="0 B/s" Foreground="#4cc2ff" FontWeight="Bold" Margin="0,0,14,0"/>
                    <TextBlock Text="平均：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="AvgLabel" Text="0 B/s" Margin="0,0,14,0"/>
                    <TextBlock Text="剩余：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="EtaLabel" Text="--:--" Margin="0,0,14,0"/>
                    <TextBlock Text="已用：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="ElapsedLabel" Text="00:00" Margin="0,0,14,0"/>
                    <TextBlock Text="线程：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="WorkersLabel" Text="0/0" Margin="0,0,14,0"/>
                    <TextBlock Text="分片：" Foreground="#9a9aa5"/>
                    <TextBlock x:Name="SegsLabel" Text="0/0"/>
                </WrapPanel>

                <StackPanel x:Name="VerifyRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="VerifyLabel" Text="完整性校验中…" Foreground="#ffd166" Width="180"/>
                    <ProgressBar x:Name="VerifyBar" Width="320" Foreground="#6dd66d" IsIndeterminate="True"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主区域：速度曲线 + 日志 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="168"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2a2a31" BorderBrush="#3c3c46" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="下载速度曲线" Foreground="#9a9aa5" Margin="2,0,0,4"/>
                    <Canvas x:Name="SpeedCanvas" Grid.Row="1" Background="#16161a"
                            ClipToBounds="True"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#2a2a31" BorderBrush="#3c3c46" BorderThickness="1"
                    CornerRadius="6" Padding="2">
                <RichTextBox x:Name="LogBox" Background="#16161a" Foreground="#e6e6ea"
                             BorderThickness="0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei, monospace" FontSize="12"/>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <DockPanel Grid.Row="5" Background="#16161a" Margin="0,8,0,0" LastChildFill="True">
            <TextBlock x:Name="StatusPhase" Text="阶段: 待命" Foreground="#4cc2ff"
                       DockPanel.Dock="Left" Padding="8,5" FontWeight="Bold"/>
            <TextBlock x:Name="StatusDetail" Text="" Foreground="#9a9aa5"
                       DockPanel.Dock="Left" Padding="0,5" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
